	(gr_text "Matt's PoE PD prototype board\nhttps://github.com/mhardeman/matt-poe-prototype\n\nNotes:\n\nPG-TP1  - PoE {dblquote}PWRGND{dblquote} / PoE VSS test point\nSW-TP2  - Test point for switch node of TPE15017\n              should eliminate this & its trace in deployment for EMI sake\nGND-TP3 - Payload / board isolated {dblquote}GND{dblquote} test point\n12V-TP4 - Test point to access 12V rail\n5V-TP5  - Test point to access 5V rail\n\nJP1 - Disconnect / current measurement point for PoE -> bridge rectifiers\nJP2 - Disconnect / current measurement point for BRs -> MP8017/TPE15017 input stage\nJP3 - Disconnect / current measurement point for 12V output stage prior to 5V stage\nJP4 - Disconnect / current measurement point for 5V output\n       5V load would continue downline of right-hand-side of JP4."
		(at 137.94 96.63 0)
		(layer "F.SilkS")
		(uuid "2785064b-cc25-4646-a092-4a5697bf4d9c")
		(effects
			(font
				(size 1.2 1.2)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "Hey!\n\nI've just met you...\nAnd this is crazy...\n\nHand me that network,\nfor some power, maybe!\n"
		(at 194.58 66.87 0)
		(layer "F.SilkS")
		(uuid "92e49e20-339a-47eb-9ce9-fc3f83234426")
		(effects
